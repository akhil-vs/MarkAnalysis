// use prisma-8

native_enum Role {
  PLATFORM_ADMIN = "PLATFORM_ADMIN"
  PRINCIPAL = "PRINCIPAL"
  EXAM_COORDINATOR = "EXAM_COORDINATOR"
  TEACHER = "TEACHER"
}

native_enum UserStatus {
  PENDING = "PENDING"
  ACTIVE = "ACTIVE"
  REJECTED = "REJECTED"
}

native_enum SchoolStatus {
  ACTIVE = "ACTIVE"
  SUSPENDED = "SUSPENDED"
}

native_enum ExamType {
  UNIT_TEST = "UNIT_TEST"
  MID_TERM = "MID_TERM"
  FINAL = "FINAL"
}

native_enum MarkStatus {
  DRAFT = "DRAFT"
  SUBMITTED = "SUBMITTED"
  APPROVED = "APPROVED"
}

native_enum MarkOutcome {
  SCORED = "SCORED"
  ABSENT = "ABSENT"
  EXEMPT = "EXEMPT"
  WITHHELD = "WITHHELD"
}

native_enum StudentStatus {
  ACTIVE = "ACTIVE"
  PROMOTED = "PROMOTED"
  TRANSFERRED = "TRANSFERRED"
  LEFT = "LEFT"
}

native_enum MarkEntryAccessKind {
  LATE_ENTRY = "LATE_ENTRY"
  EDIT = "EDIT"
}

native_enum MarkEntryAccessStatus {
  PENDING = "PENDING"
  APPROVED = "APPROVED"
  REJECTED = "REJECTED"
}

/// One tenant: a school that owns users, records, and settings.
model School {
  id             String       @id @default(cuid(2))
  slug           String       @unique
  joinCode       String       @unique
  name           String
  /// Abbreviation used in compact UI (sidebar, mobile header).
  shortName      String?
  motto          String?
  /// PNG or JPEG bytes for letterheads and the school profile preview.
  logoBytes      Bytes?
  logoMimeType   String?
  board          String?
  affiliationNo  String?
  udiseCode      String?
  recognitionNo  String?
  establishedYear Int?
  principalName  String?
  address        String?
  city           String?
  district       String?
  state          String?
  pincode        String?
  phone          String?
  alternatePhone String?
  email          String?
  website        String?
  status         pg.enum(SchoolStatus) @default("ACTIVE")
  /// Pass threshold used in analytics (percent).
  passPercent    Float        @default(50)
  /// Distinction / high-achievement threshold (percent).
  distinctionMin Float        @default(90)
  /// Optional override of letter-grade bands: [{ grade, min }, ...] sorted high→low.
  gradeBands     Jsonb?
  /// Weights for annual composite by ExamType: { UNIT_TEST, MID_TERM, FINAL }.
  examWeights    Jsonb?
  /// Working weekdays as ISO numbers 1=Mon … 7=Sun. Length 5 or 6; order is column order.
  workingDays    Jsonb?
  createdAt      TimestamptzString     @default(now())
  updatedAt temporal.updatedAtString()

  /// When true, leadership digests are emailed (SMTP) in addition to in-app notices.
  emailDigestsEnabled Boolean @default(false)
  /// Optional override recipient for school digests (defaults to school.email / principal).
  digestEmail         String?
  /// Principal-defined staff role titles: [{ id, name, baseRole }, ...] (baseRole TEACHER|EXAM_COORDINATOR).
  customStaffRoles    Jsonb?
  /// Per-role feature toggles: { TEACHER|EXAM_COORDINATOR|customRoleId: { featureId: boolean } }.
  roleFeatureAccess   Jsonb?

  users                 User[]
  classSections         ClassSection[]
  subjects              Subject[]
  students              Student[]
  exams                 Exam[]
  periods               Period[]
  timetableEntries      TimetableEntry[]
  assignments           TeacherAssignment[]
  marks                 Mark[]
  markAudits            MarkAudit[]
  markEntryRequests     MarkEntryAccessRequest[]
  notifications         Notification[]
  activityAudits        ActivityAudit[]
  portalLinks           PortalAccessLink[]
  subjectEnrollments    StudentSubjectEnrollment[]
  examPaperSchedules    ExamPaperSchedule[]
  reportCardReleases    ReportCardRelease[]
  revaluationRequests   RevaluationRequest[]
  boardPacks            BoardPack[]
  cpdTrainingPlans      CpdTrainingPlan[]
  cpdObservations       CpdObservation[]
  cpdAppraisals         CpdAppraisal[]
  cpdCertificates       CpdCertificate[]
  emailOutbox           EmailOutbox[]
  @@map("School")
}

model User {
  id                 String     @id @default(cuid(2))
  /// Tenant school. Null only for PLATFORM_ADMIN.
  tenantId           String?
  name               String
  email              String?    @unique
  /// Staff / employee code, unique within the school (not the tenant id).
  schoolId           String?
  passwordHash       String
  mustChangePassword Boolean    @default(false)
  /// TOTP MFA enabled for this account.
  mfaEnabled         Boolean    @default(false)
  /// Base32 TOTP secret (only when MFA enrolled).
  mfaSecret          String?
  /// Hashed one-time recovery codes (JSON string array of hashes).
  mfaRecoveryHashes  Jsonb?
  role               pg.enum(Role)
  /// Optional school-defined title shown instead of the system role label (e.g. "HOD Science").
  roleTitle          String?
  status             pg.enum(UserStatus) @default("PENDING")
  createdAt          TimestamptzString   @default(now())

  tenant             School? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  classTeacherOf     ClassSection[]            @relation("ClassTeacher")
  assignments        TeacherAssignment[]
  enteredMarks       Mark[]                    @relation("EnteredBy")
  audits             MarkAudit[]
  markEntryRequests  MarkEntryAccessRequest[]  @relation("MarkEntryTeacher")
  reviewedMarkEntryRequests MarkEntryAccessRequest[] @relation("MarkEntryReviewer")
  notifications      Notification[]
  timetableEntries   TimetableEntry[]
  activityAudits     ActivityAudit[]
  consolidationLocks Exam[]                    @relation("ConsolidationLockedBy")
  portalLinks        PortalAccessLink[]        @relation("PortalLinkCreator")
  refreshTokens      RefreshToken[]
  reportCardSigned   ReportCardRelease[]       @relation("ReportCardSigner")
  revaluationsRequested RevaluationRequest[]   @relation("RevalRequester")
  revaluationsReviewed  RevaluationRequest[]   @relation("RevalReviewer")
  boardPacksCreated  BoardPack[]               @relation("BoardPackCreator")
  cpdPlansOwned      CpdTrainingPlan[]         @relation("CpdPlanTeacher")
  cpdPlansCreated    CpdTrainingPlan[]         @relation("CpdPlanCreator")
  cpdObservationsAsTeacher CpdObservation[]    @relation("CpdObsTeacher")
  cpdObservationsAsObserver CpdObservation[]   @relation("CpdObsObserver")
  cpdAppraisalsAsTeacher CpdAppraisal[]        @relation("CpdAppraisalTeacher")
  cpdAppraisalsAsAppraiser CpdAppraisal[]      @relation("CpdAppraisalAppraiser")
  cpdCertificates    CpdCertificate[]          @relation("CpdCertTeacher")
  cpdCertificatesIssued CpdCertificate[]       @relation("CpdCertIssuer")

  @@unique([tenantId, schoolId])
  @@index([tenantId])
  @@map("User")
}

/// Opaque refresh sessions (hashed) for httpOnly cookie auth.
model RefreshToken {
  id        String    @id @default(cuid(2))
  userId    String
  tokenHash String    @unique
  expiresAt TimestamptzString
  revokedAt TimestamptzString?
  createdAt TimestamptzString  @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("RefreshToken")
}

model ClassSection {
  id             String  @id @default(cuid(2))
  tenantId       String
  className      String
  section        String
  classTeacherId String?
  classTeacher   User?   @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  tenant         School  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  students          Student[]
  assignments       TeacherAssignment[]
  markEntryRequests MarkEntryAccessRequest[]
  timetableEntries  TimetableEntry[]
  reportCardReleases ReportCardRelease[]

  @@unique([tenantId, className, section])
  @@index([tenantId])
  @@map("ClassSection")
}

model Subject {
  id                String  @id @default(cuid(2))
  tenantId          String
  name              String
  className         String
  /// Theory ceiling for mark entry and register validation.
  maxMarks          Int
  /// When true, only enrolled students are expected on the register / CML.
  isElective        Boolean @default(false)
  /// When set, register also collects practical marks (additive with maxMarks).
  practicalMaxMarks Int?

  tenant            School @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments       TeacherAssignment[]
  marks             Mark[]
  markEntryRequests MarkEntryAccessRequest[]
  timetableEntries  TimetableEntry[]
  enrollments       StudentSubjectEnrollment[]
  paperSchedules    ExamPaperSchedule[]
  revaluationRequests RevaluationRequest[]

  @@unique([tenantId, name, className])
  @@index([tenantId])
  @@map("Subject")
}

model StudentSubjectEnrollment {
  id        String   @id @default(cuid(2))
  tenantId  String
  studentId String
  subjectId String
  createdAt TimestamptzString @default(now())

  tenant  School  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
  @@index([subjectId])
  @@index([tenantId])
  @@map("StudentSubjectEnrollment")
}

model TeacherAssignment {
  id             String @id @default(cuid(2))
  tenantId       String
  userId         String
  classSectionId String
  subjectId      String

  tenant       School       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, classSectionId, subjectId])
  @@index([tenantId])
  @@map("TeacherAssignment")
}

model Student {
  id             String        @id @default(cuid(2))
  tenantId       String
  name           String
  rollNo         String
  classSectionId String
  academicYear   String        @default("2025-26")
  status         pg.enum(StudentStatus) @default("ACTIVE")
  dob            TimestamptzString?
  guardianName   String?
  guardianPhone  String?
  /// Optional parent/guardian email for report-card and portal notifications.
  guardianEmail  String?
  promotedFromId String?

  tenant       School       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  marks        Mark[]
  subjectEnrollments StudentSubjectEnrollment[]
  promotedFrom Student?  @relation("StudentPromotion", fields: [promotedFromId], references: [id], onDelete: SetNull)
  promotedTo   Student[] @relation("StudentPromotion")
  revaluationRequests RevaluationRequest[]

  @@unique([rollNo, classSectionId])
  @@index([classSectionId, academicYear, status])
  @@index([tenantId])
  @@map("Student")
}

model PortalAccessLink {
  id          String    @id @default(cuid(2))
  tenantId    String
  tokenHash   String    @unique
  label       String?
  studentIds  String[]
  examId      String?
  expiresAt   TimestamptzString?
  revokedAt   TimestamptzString?
  createdById String
  createdAt   TimestamptzString  @default(now())

  tenant    School @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation("PortalLinkCreator", fields: [createdById], references: [id], onDelete: Cascade)
  exam      Exam?  @relation(fields: [examId], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([tenantId])
  @@map("PortalAccessLink")
}

model Exam {
  id                      String    @id @default(cuid(2))
  tenantId                String
  name                    String
  term                    String
  academicYear            String
  date                    TimestamptzString
  type                    pg.enum(ExamType)
  marksEntryDeadline      TimestamptzString?
  /// Ceiling used for this exam’s consolidated mark-list totals and percentages.
  consolidationMaxMarks   Int       @default(100)
  consolidationLocked     Boolean   @default(false)
  consolidationLockedAt   TimestamptzString?
  consolidationLockedById String?
  consolidationLockedBy   User?     @relation("ConsolidationLockedBy", fields: [consolidationLockedById], references: [id], onDelete: SetNull)
  tenant                  School    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  marks                   Mark[]
  markEntryRequests       MarkEntryAccessRequest[]
  portalLinks             PortalAccessLink[]
  paperSchedules          ExamPaperSchedule[]
  reportCardReleases      ReportCardRelease[]
  revaluationRequests     RevaluationRequest[]
  boardPacks              BoardPack[]

  @@index([tenantId])
  @@map("Exam")
}

model MarkEntryAccessRequest {
  id             String                  @id @default(cuid(2))
  tenantId       String
  examId         String
  teacherId      String
  classSectionId String
  subjectId      String
  kind           pg.enum(MarkEntryAccessKind)     @default("LATE_ENTRY")
  status         pg.enum(MarkEntryAccessStatus)   @default("PENDING")
  message        String?
  requestedAt    TimestamptzString                @default(now())
  reviewedById   String?
  reviewedAt     TimestamptzString?

  tenant       School       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam         Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  teacher      User         @relation("MarkEntryTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("MarkEntryReviewer", fields: [reviewedById], references: [id])

  @@unique([examId, teacherId, classSectionId, subjectId])
  @@index([status, requestedAt])
  @@index([tenantId])
  @@map("MarkEntryAccessRequest")
}

model Mark {
  id             String     @id @default(cuid(2))
  tenantId       String
  studentId      String
  subjectId      String
  examId         String
  marksObtained  Float?
  /// Practical component when Subject.practicalMaxMarks is set.
  practicalMarks Float?
  outcome        pg.enum(MarkOutcome) @default("SCORED")
  enteredById    String
  status         pg.enum(MarkStatus)  @default("DRAFT")
  updatedAt temporal.updatedAtString()

  tenant    School  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  enteredBy User    @relation("EnteredBy", fields: [enteredById], references: [id])
  audits    MarkAudit[]

  @@unique([studentId, subjectId, examId])
  @@index([examId, status])
  @@index([status])
  @@index([studentId])
  @@index([tenantId])
  @@map("Mark")
}

model MarkAudit {
  id          String   @id @default(cuid(2))
  tenantId    String
  markId      String
  changedById String
  oldValue    Float?
  newValue    Float
  /// Present when leadership applies a moderation / grace adjustment.
  reason      String?
  timestamp   TimestamptzString @default(now())

  tenant    School @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mark      Mark   @relation(fields: [markId], references: [id], onDelete: Cascade)
  changedBy User   @relation(fields: [changedById], references: [id])

  @@index([tenantId])
  @@map("MarkAudit")
}

native_enum AuditAction {
  MARK_CHANGED = "MARK_CHANGED"
  MARK_DELETED = "MARK_DELETED"
  MARK_SUBMITTED = "MARK_SUBMITTED"
  MARK_APPROVED = "MARK_APPROVED"
  MARK_UNAPPROVED = "MARK_UNAPPROVED"
  MARK_MODERATED = "MARK_MODERATED"
  ACCESS_REQUESTED = "ACCESS_REQUESTED"
  ACCESS_APPROVED = "ACCESS_APPROVED"
  ACCESS_REJECTED = "ACCESS_REJECTED"
  USER_CREATED = "USER_CREATED"
  USER_STATUS_CHANGED = "USER_STATUS_CHANGED"
  USER_ROLE_CHANGED = "USER_ROLE_CHANGED"
  USER_PASSWORD_RESET = "USER_PASSWORD_RESET"
  EXAM_CREATED = "EXAM_CREATED"
  EXAM_UPDATED = "EXAM_UPDATED"
  EXAM_DELETED = "EXAM_DELETED"
  SCHOOL_CREATED = "SCHOOL_CREATED"
  SCHOOL_UPDATED = "SCHOOL_UPDATED"
  SCHOOL_STATUS_CHANGED = "SCHOOL_STATUS_CHANGED"
  /// Appended after baseline (ensureSchema / migrate ADD VALUE).
  USER_UPDATED = "USER_UPDATED"
  USER_DELETED = "USER_DELETED"
  USER_ASSIGNMENTS_TRANSFERRED = "USER_ASSIGNMENTS_TRANSFERRED"
  MFA_ENABLED = "MFA_ENABLED"
  MFA_DISABLED = "MFA_DISABLED"
  REPORT_CARD_PUBLISHED = "REPORT_CARD_PUBLISHED"
  REPORT_CARD_SIGNED_OFF = "REPORT_CARD_SIGNED_OFF"
  REVALUATION_REQUESTED = "REVALUATION_REQUESTED"
  REVALUATION_REVIEWED = "REVALUATION_REVIEWED"
  BOARD_PACK_CREATED = "BOARD_PACK_CREATED"
  PARENT_NOTIFIED = "PARENT_NOTIFIED"
  BACKUP_CREATED = "BACKUP_CREATED"
  BACKUP_RESTORED = "BACKUP_RESTORED"
  CPD_UPDATED = "CPD_UPDATED"
}

/// Operational audit trail (approvals, access reviews, staff/exam changes).
/// Mark cell edits stay in MarkAudit; both feeds are merged for the audit page.
model ActivityAudit {
  id        String      @id @default(cuid(2))
  tenantId  String
  actorId   String
  action    pg.enum(AuditAction)
  summary   String
  examId    String?
  meta      Jsonb?
  timestamp TimestamptzString    @default(now())

  tenant School @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id])

  @@index([timestamp])
  @@index([actorId, timestamp])
  @@index([examId, timestamp])
  @@index([tenantId])
  @@map("ActivityAudit")
}

native_enum NotificationType {
  LATE_ENTRY_REQUESTED = "LATE_ENTRY_REQUESTED"
  LATE_ENTRY_APPROVED = "LATE_ENTRY_APPROVED"
  LATE_ENTRY_REJECTED = "LATE_ENTRY_REJECTED"
  EDIT_REQUESTED = "EDIT_REQUESTED"
  EDIT_APPROVED = "EDIT_APPROVED"
  EDIT_REJECTED = "EDIT_REJECTED"
  MARKS_SUBMITTED = "MARKS_SUBMITTED"
  DEADLINE_REMINDER = "DEADLINE_REMINDER"
  INCOMPLETE_MARKLIST = "INCOMPLETE_MARKLIST"
  STAFF_NOTICE = "STAFF_NOTICE"
  DIGEST = "DIGEST"
  REPORT_CARD_READY = "REPORT_CARD_READY"
  REVALUATION_UPDATE = "REVALUATION_UPDATE"
  PARENT_PORTAL = "PARENT_PORTAL"
  CPD_NOTICE = "CPD_NOTICE"
}

model Notification {
  id        String           @id @default(cuid(2))
  tenantId  String
  userId    String
  type      pg.enum(NotificationType)
  title     String
  body      String
  link      String?
  meta      Jsonb?
  readAt    TimestamptzString?
  createdAt TimestamptzString         @default(now())

  tenant School @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([tenantId])
  @@map("Notification")
}

/// School bell periods (teaching slots and breaks). sortOrder controls grid order.
model Period {
  id        String  @id @default(cuid(2))
  tenantId  String
  name      String
  sortOrder Int
  startTime String
  endTime   String
  isBreak   Boolean @default(false)

  tenant  School           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries TimetableEntry[]

  @@unique([tenantId, sortOrder])
  @@index([tenantId])
  @@map("Period")
}

/// Weekly template slot: teacher teaches subject to a class in a period on a weekday.
/// dayOfWeek uses ISO weekday: 1 = Monday … 7 = Sunday.
model TimetableEntry {
  id             String  @id @default(cuid(2))
  tenantId       String
  teacherId      String
  classSectionId String
  subjectId      String
  periodId       String
  dayOfWeek      Int
  room           String?

  tenant       School       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher      User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  period       Period       @relation(fields: [periodId], references: [id], onDelete: Cascade)

  /// Same teacher may teach multiple classes in one period (e.g. combined sections).
  @@unique([teacherId, dayOfWeek, periodId, classSectionId])
  /// A class section still has at most one subject/teacher per period.
  @@unique([classSectionId, dayOfWeek, periodId])
  @@index([teacherId, dayOfWeek])
  @@index([dayOfWeek, periodId])
  @@index([tenantId])
  @@map("TimetableEntry")
}

native_enum ReportCardStatus {
  DRAFT = "DRAFT"
  PUBLISHED = "PUBLISHED"
  SIGNED_OFF = "SIGNED_OFF"
}

native_enum RevaluationStatus {
  PENDING = "PENDING"
  APPROVED = "APPROVED"
  REJECTED = "REJECTED"
  COMPLETED = "COMPLETED"
}

native_enum BoardPackStatus {
  PENDING = "PENDING"
  READY = "READY"
  FAILED = "FAILED"
}

native_enum CpdPlanStatus {
  PLANNED = "PLANNED"
  IN_PROGRESS = "IN_PROGRESS"
  COMPLETED = "COMPLETED"
  CANCELLED = "CANCELLED"
}

native_enum EmailOutboxStatus {
  PENDING = "PENDING"
  SENT = "SENT"
  FAILED = "FAILED"
  SKIPPED = "SKIPPED"
}

/// Per-paper exam calendar row (subject sitting date within an exam window).
model ExamPaperSchedule {
  id        String  @id @default(cuid(2))
  tenantId  String
  examId    String
  subjectId String
  /// Class name this paper applies to (e.g. "10"); null = all classes for the subject.
  className String?
  paperDate TimestamptzString
  startTime String?
  endTime   String?
  venue     String?
  maxMarks  Int?
  notes     String?
  createdAt TimestamptzString @default(now())

  tenant  School  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examId, subjectId, className])
  @@index([tenantId, examId, paperDate])
  @@map("ExamPaperSchedule")
}

/// Report-card publish / principal sign-off for a class section × exam.
model ReportCardRelease {
  id             String                 @id @default(cuid(2))
  tenantId       String
  examId         String
  classSectionId String
  status         pg.enum(ReportCardStatus) @default("DRAFT")
  publishedAt    TimestamptzString?
  signedOffAt    TimestamptzString?
  signedOffById  String?
  parentsNotifiedAt TimestamptzString?
  notes          String?
  createdAt      TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  tenant       School       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam         Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  signedOffBy  User?        @relation("ReportCardSigner", fields: [signedOffById], references: [id], onDelete: SetNull)

  @@unique([examId, classSectionId])
  @@index([tenantId, status])
  @@map("ReportCardRelease")
}

model RevaluationRequest {
  id           String                   @id @default(cuid(2))
  tenantId     String
  examId       String
  studentId    String
  subjectId    String
  status       pg.enum(RevaluationStatus) @default("PENDING")
  reason       String?
  requestedById String
  reviewedById String?
  reviewedAt   TimestamptzString?
  reviewNotes  String?
  originalMarks Float?
  revisedMarks  Float?
  feePaid      Boolean @default(false)
  createdAt    TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  tenant      School  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam        Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("RevalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User?   @relation("RevalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([examId, studentId, subjectId])
  @@index([tenantId, status])
  @@map("RevaluationRequest")
}

/// Board upload pack metadata (manifest of official exports for an exam).
model BoardPack {
  id          String                 @id @default(cuid(2))
  tenantId    String
  examId      String
  label       String?
  status      pg.enum(BoardPackStatus) @default("PENDING")
  manifest    Jsonb?
  createdById String
  createdAt   TimestamptzString @default(now())
  readyAt     TimestamptzString?
  error       String?

  tenant    School @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam      Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  createdBy User   @relation("BoardPackCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tenantId, examId])
  @@map("BoardPack")
}

model CpdTrainingPlan {
  id          String               @id @default(cuid(2))
  tenantId    String
  teacherId   String
  title       String
  description String?
  academicYear String
  status      pg.enum(CpdPlanStatus) @default("PLANNED")
  targetHours Float?
  completedHours Float @default(0)
  createdById String
  createdAt   TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  tenant    School @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher   User   @relation("CpdPlanTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  createdBy User   @relation("CpdPlanCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tenantId, teacherId])
  @@index([tenantId, academicYear])
  @@map("CpdTrainingPlan")
}

model CpdObservation {
  id            String  @id @default(cuid(2))
  tenantId      String
  teacherId     String
  observerId    String
  observedAt    TimestamptzString
  classLabel    String?
  subjectLabel  String?
  rating        Int?
  strengths     String?
  developmentAreas String?
  notes         String?
  createdAt     TimestamptzString @default(now())

  tenant   School @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher  User   @relation("CpdObsTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  observer User   @relation("CpdObsObserver", fields: [observerId], references: [id], onDelete: Cascade)

  @@index([tenantId, teacherId])
  @@map("CpdObservation")
}

model CpdAppraisal {
  id           String  @id @default(cuid(2))
  tenantId     String
  teacherId    String
  appraiserId  String
  academicYear String
  periodLabel  String?
  overallRating Int?
  goalsMet     String?
  nextGoals    String?
  comments     String?
  signedAt     TimestamptzString?
  createdAt    TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  tenant    School @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher   User   @relation("CpdAppraisalTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  appraiser User   @relation("CpdAppraisalAppraiser", fields: [appraiserId], references: [id], onDelete: Cascade)

  @@unique([teacherId, academicYear, periodLabel])
  @@index([tenantId, academicYear])
  @@map("CpdAppraisal")
}

model CpdCertificate {
  id          String  @id @default(cuid(2))
  tenantId    String
  teacherId   String
  title       String
  provider    String?
  hours       Float?
  earnedAt    TimestamptzString
  expiresAt   TimestamptzString?
  certificateNo String?
  notes       String?
  issuedById  String?
  createdAt   TimestamptzString @default(now())

  tenant   School @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher  User   @relation("CpdCertTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  issuedBy User?  @relation("CpdCertIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([tenantId, teacherId])
  @@map("CpdCertificate")
}

/// Outbound email queue / audit (digests, parent notify, staff digests).
model EmailOutbox {
  id        String                   @id @default(cuid(2))
  tenantId  String?
  toEmail   String
  subject   String
  bodyText  String
  bodyHtml  String?
  kind      String
  status    pg.enum(EmailOutboxStatus) @default("PENDING")
  meta      Jsonb?
  error     String?
  sentAt    TimestamptzString?
  createdAt TimestamptzString @default(now())

  tenant School? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([tenantId, createdAt])
  @@map("EmailOutbox")
}

