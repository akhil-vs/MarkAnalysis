generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PRINCIPAL
  EXAM_COORDINATOR
  TEACHER
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum ExamType {
  UNIT_TEST
  MID_TERM
  FINAL
}

enum MarkStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum MarkOutcome {
  SCORED
  ABSENT
  EXEMPT
  WITHHELD
}

enum StudentStatus {
  ACTIVE
  PROMOTED
  TRANSFERRED
  LEFT
}

enum MarkEntryAccessKind {
  LATE_ENTRY
  EDIT
}

enum MarkEntryAccessStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                  String     @id @default(cuid())
  name                String
  email               String?    @unique
  schoolId            String?    @unique
  passwordHash        String
  mustChangePassword  Boolean    @default(false)
  role                Role
  status              UserStatus @default(PENDING)
  createdAt           DateTime   @default(now())

  classTeacherOf ClassSection[]       @relation("ClassTeacher")
  assignments    TeacherAssignment[]
  enteredMarks   Mark[]               @relation("EnteredBy")
  audits         MarkAudit[]
  markEntryRequests MarkEntryAccessRequest[] @relation("MarkEntryTeacher")
  reviewedMarkEntryRequests MarkEntryAccessRequest[] @relation("MarkEntryReviewer")
  notifications  Notification[]
  timetableEntries TimetableEntry[]
  activityAudits ActivityAudit[]
  consolidationLocks Exam[] @relation("ConsolidationLockedBy")
  refreshTokens  RefreshToken[]
}

/// Opaque refresh sessions (hashed) for httpOnly cookie auth.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ClassSection {
  id             String  @id @default(cuid())
  className      String
  section        String
  classTeacherId String?
  classTeacher   User?   @relation("ClassTeacher", fields: [classTeacherId], references: [id])

  students          Student[]
  assignments       TeacherAssignment[]
  markEntryRequests MarkEntryAccessRequest[]
  timetableEntries  TimetableEntry[]

  @@unique([className, section])
}

model Subject {
  id        String @id @default(cuid())
  name      String
  className String
  /// Ceiling for mark entry and register validation.
  maxMarks  Int

  assignments TeacherAssignment[]
  marks       Mark[]
  markEntryRequests MarkEntryAccessRequest[]
  timetableEntries TimetableEntry[]

  @@unique([name, className])
}

model TeacherAssignment {
  id             String @id @default(cuid())
  userId         String
  classSectionId String
  subjectId      String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, classSectionId, subjectId])
}

model Student {
  id             String        @id @default(cuid())
  name           String
  rollNo         String
  classSectionId String
  academicYear   String        @default("2025-26")
  status         StudentStatus @default(ACTIVE)
  dob            DateTime?
  guardianName   String?
  guardianPhone  String?
  promotedFromId String?

  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  marks        Mark[]
  promotedFrom Student?  @relation("StudentPromotion", fields: [promotedFromId], references: [id], onDelete: SetNull)
  promotedTo   Student[] @relation("StudentPromotion")

  @@unique([rollNo, classSectionId])
  @@index([classSectionId, academicYear, status])
}

model Exam {
  id                 String    @id @default(cuid())
  name               String
  term               String
  academicYear       String
  date               DateTime
  type               ExamType
  marksEntryDeadline DateTime?
  /// Ceiling used for this exam’s consolidated mark-list totals and percentages.
  consolidationMaxMarks Int      @default(100)
  consolidationLocked   Boolean  @default(false)
  consolidationLockedAt DateTime?
  consolidationLockedById String?
  consolidationLockedBy User?    @relation("ConsolidationLockedBy", fields: [consolidationLockedById], references: [id], onDelete: SetNull)
  marks              Mark[]
  markEntryRequests  MarkEntryAccessRequest[]
}

model MarkEntryAccessRequest {
  id             String                  @id @default(cuid())
  examId         String
  teacherId      String
  classSectionId String
  subjectId      String
  kind           MarkEntryAccessKind     @default(LATE_ENTRY)
  status         MarkEntryAccessStatus   @default(PENDING)
  message        String?
  requestedAt    DateTime                @default(now())
  reviewedById   String?
  reviewedAt     DateTime?

  exam         Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  teacher      User         @relation("MarkEntryTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("MarkEntryReviewer", fields: [reviewedById], references: [id])

  @@unique([examId, teacherId, classSectionId, subjectId])
  @@index([status, requestedAt])
}

model Mark {
  id            String     @id @default(cuid())
  studentId     String
  subjectId     String
  examId        String
  marksObtained Float?
  outcome       MarkOutcome @default(SCORED)
  enteredById   String
  status        MarkStatus @default(DRAFT)
  updatedAt     DateTime   @updatedAt

  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  exam      Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  enteredBy User        @relation("EnteredBy", fields: [enteredById], references: [id])
  audits    MarkAudit[]

  @@unique([studentId, subjectId, examId])
  @@index([examId, status])
  @@index([status])
  @@index([studentId])
}

model MarkAudit {
  id          String   @id @default(cuid())
  markId      String
  changedById String
  oldValue    Float?
  newValue    Float
  /// Present when leadership applies a moderation / grace adjustment.
  reason      String?
  timestamp   DateTime @default(now())

  mark      Mark @relation(fields: [markId], references: [id], onDelete: Cascade)
  changedBy User @relation(fields: [changedById], references: [id])
}

enum AuditAction {
  MARK_CHANGED
  MARK_DELETED
  MARK_SUBMITTED
  MARK_APPROVED
  MARK_UNAPPROVED
  MARK_MODERATED
  ACCESS_REQUESTED
  ACCESS_APPROVED
  ACCESS_REJECTED
  USER_CREATED
  USER_STATUS_CHANGED
  USER_ROLE_CHANGED
  USER_PASSWORD_RESET
  EXAM_CREATED
  EXAM_UPDATED
  EXAM_DELETED
}

/// Operational audit trail (approvals, access reviews, staff/exam changes).
/// Mark cell edits stay in MarkAudit; both feeds are merged for the audit page.
model ActivityAudit {
  id        String      @id @default(cuid())
  actorId   String
  action    AuditAction
  summary   String
  examId    String?
  meta      Json?
  timestamp DateTime    @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([timestamp])
  @@index([actorId, timestamp])
  @@index([examId, timestamp])
}

model SchoolProfile {
  id              String   @id @default("school")
  name            String
  board           String?
  affiliationNo   String?
  address         String?
  phone           String?
  email           String?
  /// Pass threshold used in analytics (percent).
  passPercent     Float    @default(50)
  /// Distinction / high-achievement threshold (percent).
  distinctionMin  Float    @default(90)
  /// Optional override of letter-grade bands: [{ grade, min }, ...] sorted high→low.
  gradeBands      Json?
  /// Weights for annual composite by ExamType: { UNIT_TEST, MID_TERM, FINAL }.
  examWeights     Json?
  /// Working weekdays as ISO numbers 1=Mon … 7=Sun. Length 5 or 6; order is column order.
  workingDays     Json?
  updatedAt       DateTime @updatedAt
}

enum NotificationType {
  LATE_ENTRY_REQUESTED
  LATE_ENTRY_APPROVED
  LATE_ENTRY_REJECTED
  EDIT_REQUESTED
  EDIT_APPROVED
  EDIT_REJECTED
  MARKS_SUBMITTED
  DEADLINE_REMINDER
  INCOMPLETE_MARKLIST
  STAFF_NOTICE
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  meta      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// School bell periods (teaching slots and breaks). sortOrder controls grid order.
model Period {
  id        String  @id @default(cuid())
  name      String
  sortOrder Int     @unique
  startTime String
  endTime   String
  isBreak   Boolean @default(false)

  entries TimetableEntry[]
}

/// Weekly template slot: teacher teaches subject to a class in a period on a weekday.
/// dayOfWeek uses ISO weekday: 1 = Monday … 7 = Sunday.
model TimetableEntry {
  id             String  @id @default(cuid())
  teacherId      String
  classSectionId String
  subjectId      String
  periodId       String
  dayOfWeek      Int
  room           String?

  teacher      User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  period       Period       @relation(fields: [periodId], references: [id], onDelete: Cascade)

  /// Same teacher may teach multiple classes in one period (e.g. combined sections).
  @@unique([teacherId, dayOfWeek, periodId, classSectionId])
  /// A class section still has at most one subject/teacher per period.
  @@unique([classSectionId, dayOfWeek, periodId])
  @@index([teacherId, dayOfWeek])
  @@index([dayOfWeek, periodId])
}
