generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PRINCIPAL
  EXAM_COORDINATOR
  TEACHER
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
}

enum ExamType {
  UNIT_TEST
  MID_TERM
  FINAL
}

enum MarkStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum MarkOutcome {
  SCORED
  ABSENT
  EXEMPT
  WITHHELD
}

enum StudentStatus {
  ACTIVE
  PROMOTED
  TRANSFERRED
  LEFT
}

enum MarkEntryAccessKind {
  LATE_ENTRY
  EDIT
}

enum MarkEntryAccessStatus {
  PENDING
  APPROVED
  REJECTED
}

/// One tenant: a school that owns users, records, and settings.
model School {
  id             String       @id @default(cuid())
  slug           String       @unique
  joinCode       String       @unique
  name           String
  board          String?
  affiliationNo  String?
  address        String?
  phone          String?
  email          String?
  status         SchoolStatus @default(ACTIVE)
  /// Pass threshold used in analytics (percent).
  passPercent    Float        @default(50)
  /// Distinction / high-achievement threshold (percent).
  distinctionMin Float        @default(90)
  /// Optional override of letter-grade bands: [{ grade, min }, ...] sorted high→low.
  gradeBands     Json?
  /// Weights for annual composite by ExamType: { UNIT_TEST, MID_TERM, FINAL }.
  examWeights    Json?
  /// Working weekdays as ISO numbers 1=Mon … 7=Sun. Length 5 or 6; order is column order.
  workingDays    Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users                 User[]
  classSections         ClassSection[]
  subjects              Subject[]
  students              Student[]
  exams                 Exam[]
  periods               Period[]
  timetableEntries      TimetableEntry[]
  assignments           TeacherAssignment[]
  marks                 Mark[]
  markAudits            MarkAudit[]
  markEntryRequests     MarkEntryAccessRequest[]
  notifications         Notification[]
  activityAudits        ActivityAudit[]
  portalLinks           PortalAccessLink[]
  subjectEnrollments    StudentSubjectEnrollment[]
}

model User {
  id                 String     @id @default(cuid())
  tenantId           String
  name               String
  email              String?    @unique
  /// Staff / employee code, unique within the school (not the tenant id).
  schoolId           String?
  passwordHash       String
  mustChangePassword Boolean    @default(false)
  role               Role
  status             UserStatus @default(PENDING)
  createdAt          DateTime   @default(now())

  tenant             School @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  classTeacherOf     ClassSection[]            @relation("ClassTeacher")
  assignments        TeacherAssignment[]
  enteredMarks       Mark[]                    @relation("EnteredBy")
  audits             MarkAudit[]
  markEntryRequests  MarkEntryAccessRequest[]  @relation("MarkEntryTeacher")
  reviewedMarkEntryRequests MarkEntryAccessRequest[] @relation("MarkEntryReviewer")
  notifications      Notification[]
  timetableEntries   TimetableEntry[]
  activityAudits     ActivityAudit[]
  consolidationLocks Exam[]                    @relation("ConsolidationLockedBy")
  portalLinks        PortalAccessLink[]        @relation("PortalLinkCreator")
  refreshTokens      RefreshToken[]

  @@unique([tenantId, schoolId])
  @@index([tenantId])
}

/// Opaque refresh sessions (hashed) for httpOnly cookie auth.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ClassSection {
  id             String  @id @default(cuid())
  tenantId       String
  className      String
  section        String
  classTeacherId String?
  classTeacher   User?   @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  tenant         School  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  students          Student[]
  assignments       TeacherAssignment[]
  markEntryRequests MarkEntryAccessRequest[]
  timetableEntries  TimetableEntry[]

  @@unique([tenantId, className, section])
  @@index([tenantId])
}

model Subject {
  id                String  @id @default(cuid())
  tenantId          String
  name              String
  className         String
  /// Theory ceiling for mark entry and register validation.
  maxMarks          Int
  /// When true, only enrolled students are expected on the register / CML.
  isElective        Boolean @default(false)
  /// When set, register also collects practical marks (additive with maxMarks).
  practicalMaxMarks Int?

  tenant            School @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments       TeacherAssignment[]
  marks             Mark[]
  markEntryRequests MarkEntryAccessRequest[]
  timetableEntries  TimetableEntry[]
  enrollments       StudentSubjectEnrollment[]

  @@unique([tenantId, name, className])
  @@index([tenantId])
}

model StudentSubjectEnrollment {
  id        String   @id @default(cuid())
  tenantId  String
  studentId String
  subjectId String
  createdAt DateTime @default(now())

  tenant  School  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
  @@index([subjectId])
  @@index([tenantId])
}

model TeacherAssignment {
  id             String @id @default(cuid())
  tenantId       String
  userId         String
  classSectionId String
  subjectId      String

  tenant       School       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, classSectionId, subjectId])
  @@index([tenantId])
}

model Student {
  id             String        @id @default(cuid())
  tenantId       String
  name           String
  rollNo         String
  classSectionId String
  academicYear   String        @default("2025-26")
  status         StudentStatus @default(ACTIVE)
  dob            DateTime?
  guardianName   String?
  guardianPhone  String?
  promotedFromId String?

  tenant       School       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  marks        Mark[]
  subjectEnrollments StudentSubjectEnrollment[]
  promotedFrom Student?  @relation("StudentPromotion", fields: [promotedFromId], references: [id], onDelete: SetNull)
  promotedTo   Student[] @relation("StudentPromotion")

  @@unique([rollNo, classSectionId])
  @@index([classSectionId, academicYear, status])
  @@index([tenantId])
}

model PortalAccessLink {
  id          String    @id @default(cuid())
  tenantId    String
  tokenHash   String    @unique
  label       String?
  studentIds  String[]
  examId      String?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  tenant    School @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation("PortalLinkCreator", fields: [createdById], references: [id], onDelete: Cascade)
  exam      Exam?  @relation(fields: [examId], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([tenantId])
}

model Exam {
  id                      String    @id @default(cuid())
  tenantId                String
  name                    String
  term                    String
  academicYear            String
  date                    DateTime
  type                    ExamType
  marksEntryDeadline      DateTime?
  /// Ceiling used for this exam’s consolidated mark-list totals and percentages.
  consolidationMaxMarks   Int       @default(100)
  consolidationLocked     Boolean   @default(false)
  consolidationLockedAt   DateTime?
  consolidationLockedById String?
  consolidationLockedBy   User?     @relation("ConsolidationLockedBy", fields: [consolidationLockedById], references: [id], onDelete: SetNull)
  tenant                  School    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  marks                   Mark[]
  markEntryRequests       MarkEntryAccessRequest[]
  portalLinks             PortalAccessLink[]

  @@index([tenantId])
}

model MarkEntryAccessRequest {
  id             String                  @id @default(cuid())
  tenantId       String
  examId         String
  teacherId      String
  classSectionId String
  subjectId      String
  kind           MarkEntryAccessKind     @default(LATE_ENTRY)
  status         MarkEntryAccessStatus   @default(PENDING)
  message        String?
  requestedAt    DateTime                @default(now())
  reviewedById   String?
  reviewedAt     DateTime?

  tenant       School       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam         Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  teacher      User         @relation("MarkEntryTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("MarkEntryReviewer", fields: [reviewedById], references: [id])

  @@unique([examId, teacherId, classSectionId, subjectId])
  @@index([status, requestedAt])
  @@index([tenantId])
}

model Mark {
  id             String     @id @default(cuid())
  tenantId       String
  studentId      String
  subjectId      String
  examId         String
  marksObtained  Float?
  /// Practical component when Subject.practicalMaxMarks is set.
  practicalMarks Float?
  outcome        MarkOutcome @default(SCORED)
  enteredById    String
  status         MarkStatus  @default(DRAFT)
  updatedAt      DateTime    @updatedAt

  tenant    School  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  enteredBy User    @relation("EnteredBy", fields: [enteredById], references: [id])
  audits    MarkAudit[]

  @@unique([studentId, subjectId, examId])
  @@index([examId, status])
  @@index([status])
  @@index([studentId])
  @@index([tenantId])
}

model MarkAudit {
  id          String   @id @default(cuid())
  tenantId    String
  markId      String
  changedById String
  oldValue    Float?
  newValue    Float
  /// Present when leadership applies a moderation / grace adjustment.
  reason      String?
  timestamp   DateTime @default(now())

  tenant    School @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mark      Mark   @relation(fields: [markId], references: [id], onDelete: Cascade)
  changedBy User   @relation(fields: [changedById], references: [id])

  @@index([tenantId])
}

enum AuditAction {
  MARK_CHANGED
  MARK_DELETED
  MARK_SUBMITTED
  MARK_APPROVED
  MARK_UNAPPROVED
  MARK_MODERATED
  ACCESS_REQUESTED
  ACCESS_APPROVED
  ACCESS_REJECTED
  USER_CREATED
  USER_STATUS_CHANGED
  USER_ROLE_CHANGED
  USER_PASSWORD_RESET
  EXAM_CREATED
  EXAM_UPDATED
  EXAM_DELETED
}

/// Operational audit trail (approvals, access reviews, staff/exam changes).
/// Mark cell edits stay in MarkAudit; both feeds are merged for the audit page.
model ActivityAudit {
  id        String      @id @default(cuid())
  tenantId  String
  actorId   String
  action    AuditAction
  summary   String
  examId    String?
  meta      Json?
  timestamp DateTime    @default(now())

  tenant School @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id])

  @@index([timestamp])
  @@index([actorId, timestamp])
  @@index([examId, timestamp])
  @@index([tenantId])
}

enum NotificationType {
  LATE_ENTRY_REQUESTED
  LATE_ENTRY_APPROVED
  LATE_ENTRY_REJECTED
  EDIT_REQUESTED
  EDIT_APPROVED
  EDIT_REJECTED
  MARKS_SUBMITTED
  DEADLINE_REMINDER
  INCOMPLETE_MARKLIST
  STAFF_NOTICE
}

model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  meta      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  tenant School @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([tenantId])
}

/// School bell periods (teaching slots and breaks). sortOrder controls grid order.
model Period {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  sortOrder Int
  startTime String
  endTime   String
  isBreak   Boolean @default(false)

  tenant  School           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries TimetableEntry[]

  @@unique([tenantId, sortOrder])
  @@index([tenantId])
}

/// Weekly template slot: teacher teaches subject to a class in a period on a weekday.
/// dayOfWeek uses ISO weekday: 1 = Monday … 7 = Sunday.
model TimetableEntry {
  id             String  @id @default(cuid())
  tenantId       String
  teacherId      String
  classSectionId String
  subjectId      String
  periodId       String
  dayOfWeek      Int
  room           String?

  tenant       School       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher      User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  period       Period       @relation(fields: [periodId], references: [id], onDelete: Cascade)

  /// Same teacher may teach multiple classes in one period (e.g. combined sections).
  @@unique([teacherId, dayOfWeek, periodId, classSectionId])
  /// A class section still has at most one subject/teacher per period.
  @@unique([classSectionId, dayOfWeek, periodId])
  @@index([teacherId, dayOfWeek])
  @@index([dayOfWeek, periodId])
  @@index([tenantId])
}
