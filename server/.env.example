DATABASE_URL="postgresql://marks:marks@localhost:5432/marks?schema=public"

# --- Auth (required in production / Vercel) ---
# Strong random secret (≥16 chars). The API refuses to boot on Vercel/production
# when this is missing or still set to the placeholder below.
JWT_SECRET="change-me-in-production"
# Short-lived access JWT in the sma_access httpOnly cookie (default 15m)
JWT_ACCESS_EXPIRES="15m"
# Refresh tokens live in sma_refresh (httpOnly, 30 days) and rotate on /api/auth/refresh

# Comma-separated SPA origins for credentialed CORS.
# On Vercel, https://$VERCEL_URL and https://$VERCEL_PROJECT_PRODUCTION_URL are also allowed.
# Do not rely on a blanket VERCEL reflect — set CLIENT_ORIGIN for custom domains.
CLIENT_ORIGIN="http://localhost:5173"
# Force Secure cookies locally when testing over HTTPS. Auto-on when VERCEL=1 or NODE_ENV=production.
# COOKIE_SECURE="true"
# Fail boot even in development if JWT_SECRET is weak:
# REQUIRE_SECURE_AUTH="true"

PORT=4000

# --- Seed / demos ---
# Require password change on first login for seeded accounts
SEED_FORCE_PASSWORD_CHANGE="false"
# Seed skips when users already exist. To wipe and reseed:
# SEED_MODE=wipe
# ALLOW_DESTRUCTIVE_SEED=true

# --- Migrations ---
# Skip cold-start migrate deploy (ensurePendingSchema still runs):
# SKIP_MIGRATE_DEPLOY=true
# On Vercel, force spawn-based migrate instead of ensure-only fast path:
# FORCE_MIGRATE_DEPLOY=true

# Rate limit store: "database" (default when DATABASE_URL is set) or "memory" (tests).
# RATE_LIMIT_STORE=memory
