DATABASE_URL="postgresql://marks:marks@localhost:5432/marks?schema=public"
# Vercel / Neon pooled aliases (preferred on serverless over a direct DATABASE_URL):
# POSTGRES_URL="postgresql://…"
# POSTGRES_PRISMA_URL="postgresql://…"
# DATABASE_USE_POOLED="true"

# --- Auth (required in production / Vercel) ---
# Strong random secret (≥16 chars). The API refuses to boot on Vercel/production
# when this is missing or still set to the placeholder below.
JWT_SECRET="change-me-in-production"
# Optional dedicated key for MFA TOTP secrets (64 hex chars or ≥16-char passphrase).
# When unset, a key is derived from JWT_SECRET.
# MFA_ENCRYPTION_KEY=""
# Self-serve POST /api/schools/register — keep false for pilots (use /request-pilot).
# ALLOW_PUBLIC_SCHOOL_REGISTRATION="false"
# Short-lived access JWT in the sma_access httpOnly cookie (default 15m)
JWT_ACCESS_EXPIRES="15m"
# Refresh tokens live in sma_refresh (httpOnly, 30 days) and rotate on /api/auth/refresh

# Comma-separated SPA origins for credentialed CORS.
# On Vercel, https://$VERCEL_URL and https://$VERCEL_PROJECT_PRODUCTION_URL are also allowed.
# Do not rely on a blanket VERCEL reflect — set CLIENT_ORIGIN for custom domains.
CLIENT_ORIGIN="http://localhost:5173"
# Force Secure cookies locally when testing over HTTPS. Auto-on when VERCEL=1 or NODE_ENV=production.
# COOKIE_SECURE="true"
# Fail boot even in development if JWT_SECRET is weak:
# REQUIRE_SECURE_AUTH="true"

# --- Platform admin (production) ---
# Auth bootstrap will not create or reset admin@platform.edu / password123
# when NODE_ENV=production, VERCEL=1, or REQUIRE_SECURE_AUTH=true.
# PLATFORM_ADMIN_PASSWORD="a-long-random-admin-password"
# RESET_PLATFORM_ADMIN_PASSWORD="true"   # one-shot rotate, then unset
# PLATFORM_ADMIN_PASSWORD_LOCKED="true"
# ENSURE_PLATFORM_ADMIN="false"          # skip boot-time ensure entirely
# ALLOW_DEFAULT_PLATFORM_ADMIN="true"    # disposable demos only
# PLATFORM_ADMIN_EMAIL="admin@platform.edu"
# PLATFORM_ADMIN_SCHOOL_ID="PLT-A01"

# --- Email digests (optional) ---
# SMTP_URL="smtps://user:pass@smtp.example.com:465"
# Or discrete host settings:
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="School Marks <noreply@school.edu>"
# CSP_ENFORCE="false"  # production defaults to enforce; set false only while debugging embeds
# TRUST_PROXY="1"      # hops behind reverse proxy (default 1 on Vercel/production)
# LOG_LEVEL="info"
# SENTRY_DSN=""                    # optional; @sentry/node is a server dependency
# SENTRY_ENVIRONMENT="production"
# SENTRY_TRACES_SAMPLE_RATE="0"
# BACKUP_MAX_ROWS=250000
# SKIP_ENSURE_SCHEMA=true           # never run ensurePendingSchema catch-up
# FORCE_ENSURE_SCHEMA=true          # run catch-up even after a clean migrate
# ALLOW_ENSURE_SCHEMA_FALLBACK=false  # do not fall back when migrate fails

PORT=4000

# --- Client build (Vite) — set on the web/Vercel build, not required by the API ---
# VITE_PILOT_CONTACT_EMAIL="pilots@yourdomain.com"
# VITE_PILOT_CONTACT_URL="https://www.pencillabs.space/"
# Server-side notify for new pilot form submissions (falls back to VITE_PILOT_CONTACT_EMAIL):
# PILOT_NOTIFY_EMAIL="ops@yourdomain.com"

# --- Seed / demos ---
# Require password change on first login for seeded accounts
SEED_FORCE_PASSWORD_CHANGE="false"
# Seed skips when users already exist. To wipe and reseed:
# SEED_MODE=wipe
# ALLOW_DESTRUCTIVE_SEED=true

# --- Migrations ---
# Skip cold-start migrate deploy (ensurePendingSchema still runs unless SKIP_ENSURE_SCHEMA):
# SKIP_MIGRATE_DEPLOY=true
# On Vercel, force spawn-based migrate instead of ensure-only fast path:
# FORCE_MIGRATE_DEPLOY=true

# Rate limit store: "database" (default when DATABASE_URL is set) or "memory" (tests).
# RATE_LIMIT_STORE=memory

# --- Background jobs (long-running API only; disabled on Vercel) ---
# ENABLE_BACKGROUND_JOBS="true"
# BACKGROUND_JOB_INTERVAL_MS="300000"
# BACKGROUND_DIGEST_EVERY_N="12"

# --- Blob storage for logos / student photos ---
# database (default) or filesystem
# BLOB_STORAGE="filesystem"
# BLOB_STORAGE_PATH="/var/lib/sma-blobs"
