DATABASE_URL="postgresql://marks:marks@localhost:5432/marks?schema=public"
JWT_SECRET="change-me-in-production"
# Short-lived access JWT in the sma_access httpOnly cookie (default 15m)
JWT_ACCESS_EXPIRES="15m"
CLIENT_ORIGIN="http://localhost:5173"
PORT=4000
# Force Secure cookies locally when testing over HTTPS
# COOKIE_SECURE="true"
# Set true when seeding to require password change on first login
SEED_FORCE_PASSWORD_CHANGE="false"
